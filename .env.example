# Configuración de Variables de Entorno
# Backend SKALER

# Servidor
PORT=3000
NODE_ENV=development
API_URL=http://localhost:3000

# Base de Datos
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=skaler_db

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=24h

# Rutas
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Email (Opcional)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_password

# URLs de Aplicación
FRONTEND_URL=http://localhost:8080
DASHBOARD_URL=http://localhost:3001
WEB_APP_URL=http://localhost:8080
WEB_LAUNCH_TICKET_EXPIRE=30m
WEB_BRIDGE_SESSION_EXPIRE=30m
WEB_SESSION_EXPIRE=12h
APP_SESSION_HEARTBEAT_TTL=90s

# Términos y condiciones (login) — SKALER S.A.S. por defecto en appTerms.js
# APP_TERMS_COMPANY_LEGAL_NAME=SKALER S.A.S.
# APP_TERMS_COMPANY_NIT=900.225.517-7
# APP_TERMS_COMPANY_CITY=Cali, Valle del Cauca, Colombia
# APP_TERMS_COMPANY_ADDRESS=Calle 66 # 1N-66, Sector Industrial Calima, Cali
# APP_TERMS_COMPANY_WEBSITE=https://www.skaler.com.co
# APP_TERMS_PRIVACY_CONTACT_EMAIL=comercialymarketing@skaler.com.co
# APP_TERMS_COMPANY_PHONE=(+57) 602 447 3636
# APP_TERMS_DOCUMENT_URL=
