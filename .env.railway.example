# SKALER Backend - Railway

# Servidor
NODE_ENV=production
PORT=3000
API_URL=https://TU-BACKEND.railway.app

# Base de datos
# Usa UNA de estas dos opciones:
# 1. Pegar la URL completa que entrega Railway MySQL
DATABASE_URL=mysql://root:TU_PASSWORD@HOST:PUERTO/railway

# 2. O dejar que Railway inyecte MYSQLHOST, MYSQLPORT, MYSQLUSER,
# MYSQLPASSWORD y MYSQLDATABASE automaticamente

# Seguridad
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-unico
JWT_EXPIRE=24h

# Archivos
# Local / dev:
UPLOAD_DIR=./uploads
# Railway producción (con volumen persistente montado en /data/uploads):
# UPLOAD_DIR=/data/uploads
MAX_FILE_SIZE=10485760

# Frontend y CORS
FRONTEND_URL=https://TU-FRONTEND.web.app
WEB_APP_URL=https://TU-FRONTEND.web.app
CORS_ORIGINS=https://TU-FRONTEND.web.app,https://TU-OTRO-FRONTEND.web.app

# Sesiones enlazadas app -> web
WEB_LAUNCH_TICKET_EXPIRE=30m
WEB_BRIDGE_SESSION_EXPIRE=30m
WEB_SESSION_EXPIRE=12h
APP_SESSION_HEARTBEAT_TTL=90s

# SSL para MySQL remoto si hace falta
DB_SSL=true

# Términos y condiciones (v2.0) — datos SKALER S.A.S. (opcional; ya vienen por defecto en código)
APP_TERMS_COMPANY_LEGAL_NAME=SKALER S.A.S.
APP_TERMS_COMPANY_NIT=900.225.517-7
APP_TERMS_COMPANY_CITY=Cali, Valle del Cauca, Colombia
APP_TERMS_COMPANY_ADDRESS=Calle 66 # 1N-66, Sector Industrial Calima, Cali
APP_TERMS_COMPANY_WEBSITE=https://www.skaler.com.co
APP_TERMS_PRIVACY_CONTACT_EMAIL=comercialymarketing@skaler.com.co
APP_TERMS_COMPANY_PHONE=(+57) 602 447 3636
# APP_TERMS_DOCUMENT_URL=https://.../terminos-skaler-v2.pdf